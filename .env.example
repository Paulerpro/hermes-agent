# Copy this file to vendor/hermes-agent-framework/.env (see README) and fill in your key.

# OpenRouter gives free access to a rotating set of models — no direct
# provider key needed. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Any OpenRouter model id works; ":free" ones cost nothing. Check current
# free models at https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=z-ai/glm-5.2:free
